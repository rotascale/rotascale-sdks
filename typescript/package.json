{
  "name": "@rotascale/sdk",
  "version": "0.3.0",
  "description": "Govern the action, not the model. TypeScript SDK for Rotascale agent governance.",
  "license": "Apache-2.0",
  "author": "Subhadip Mitra <dev@rotascale.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "schema:sync": "node scripts/sync-schema.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotascale/rotascale-sdks.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/rotascale/rotascale-sdks/tree/main/typescript",
  "bugs": {
    "url": "https://github.com/rotascale/rotascale-sdks/issues"
  },
  "keywords": [
    "agent",
    "governance",
    "ai-governance",
    "eu-ai-act",
    "authorization",
    "audit",
    "llm",
    "observability"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
